# Server-only. Nothing here is exposed to the browser: there are no NEXT_PUBLIC_ variables.

# Where this app is served; OAuth redirects come back here. Locally, use a
# *.localhost name: browsers share localhost cookies across every port, and other
# apps' cookies can push requests past the header limit (HTTP 431).
SITE_URL=http://orqen.localhost:3000

# Supabase project URL and its *publishable* key (sb_publishable_...).
# Never put the secret key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The Orqen gateway. Only the Next.js server talks to it; browsers call /api/gw.
ORQEN_GATEWAY_URL=http://localhost:8000
