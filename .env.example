# Copy to .env. Every setting is read by orqen_core.settings with the ORQEN_ prefix.

ORQEN_ENV=dev
ORQEN_LOG_LEVEL=INFO
# false gives coloured console logs instead of JSON lines.
ORQEN_LOG_JSON=false

ORQEN_PG_PORT=5433
ORQEN_REDIS_PORT=6380
ORQEN_DATABASE_URL=postgresql+psycopg://orqen:orqen@localhost:5433/orqen
ORQEN_REDIS_URL=redis://localhost:6380/0

# Integration tests use these; they must not point at the dev database.
ORQEN_TEST_DATABASE_URL=postgresql+psycopg://orqen:orqen@localhost:5433/orqen_test
ORQEN_TEST_REDIS_URL=redis://localhost:6380/15

ORQEN_JWT_SECRET=dev-only-change-me

# Read only by the LLM proxy (M2). Leave empty until then.
ORQEN_ANTHROPIC_API_KEY=

ORQEN_SEED_PASSWORD=orqen-dev-password
