ORQEN_ENV=dev
ORQEN_LOG_LEVEL=INFO
ORQEN_LOG_JSON=false

ORQEN_REDIS_PORT=6380
ORQEN_REDIS_URL=redis://localhost:6380/0
ORQEN_TEST_PG_PORT=5433
ORQEN_TEST_DATABASE_URL=postgresql+psycopg://orqen:orqen@localhost:5433/orqen_test
ORQEN_TEST_REDIS_URL=redis://localhost:6380/15
ORQEN_ANTHROPIC_API_KEY=
ORQEN_PROVIDER=fake
ORQEN_PROXY_URL=http://localhost:8080

ORQEN_SEED_PASSWORD=orqen-dev-password
# Development runs on the local Postgres from compose (make up). Production uses the
# Supabase session pooler: swap the two lines below to point at it.
ORQEN_DEV_PG_PORT=5434
ORQEN_DATABASE_URL=postgresql+psycopg://orqen:orqen@localhost:5434/orqen
# ORQEN_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ORQEN_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

ORQEN_SUPABASE_URL=https://<project-ref>.supabase.co
ORQEN_SUPABASE_SECRET_KEY=sb_secret_...
